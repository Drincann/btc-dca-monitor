{
  "name": "btc-dca-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://drincann.github.io/btc-dca-monitor/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "backtest:signals": "node scripts/backtest-signals.mjs",
    "backtest:strategy": "node scripts/backtest-accumulation-strategies.mjs",
    "backtest:regimes": "node scripts/backtest-regimes.mjs",
    "backtest:report": "node scripts/generate-backtest-report.mjs",
    "verify:policy": "node scripts/verify-backtest-policy.mjs",
    "verify:runtime": "node scripts/verify-runtime-page.mjs",
    "verify:all": "npm run backtest:report && npm run verify:policy && npm run build && npm run verify:runtime"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0"
  }
}
